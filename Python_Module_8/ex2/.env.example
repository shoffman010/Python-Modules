# Copy to .env, then replace these placeholders with your own settings.
# This template contains no real credentials or service addresses.
MATRIX_MODE=development
DATABASE_URL=replace-with-your-database-url
API_KEY=replace-with-your-api-key
# Leave empty to use DEBUG in development or INFO in production.
LOG_LEVEL=
ZION_ENDPOINT=replace-with-your-zion-endpoint
